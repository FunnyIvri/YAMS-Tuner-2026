[Unit]
Description=@PACKAGE@ web server (socket activated)
Requires=@PACKAGE@.socket
After=@PACKAGE@.socket

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /usr/local/bin/@PACKAGE@/server.py /usr/share/@PACKAGE@/www
Restart=no
KillMode=mixed
TimeoutStopSec=3

DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Started by the socket unit only
[Install]
