[Unit]
Description=yams-tuner web server (socket activated)
Requires=yams-tuner.socket
After=yams-tuner.socket

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /usr/local/bin/yams-tuner/server.py /usr/share/yams-tuner/www
Restart=no
KillMode=mixed
TimeoutStopSec=3

DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Started by the socket unit only
[Install]
